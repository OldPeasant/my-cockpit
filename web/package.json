{
  "name": "cockpit-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "i18n:extract": "ng extract-i18n",
    "test": "ng test",
    "lint": "ng lint --max-warnings=0",
    "test:ci": "ng test --watch=false",
    "coverage": "ng test --watch=false --coverage --coverage-reporters=text-summary --coverage-reporters=json-summary --coverage-reporters=json --coverage-reporters=lcov",
    "api:gen": "ng-openapi-gen",
    "api:check": "node scripts/api-gen-check.mjs",
    "check": "npm run api:check && npm run lint && npm run test:ci && ng build"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "~22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "~22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fullcalendar/angular": "^7.1.3",
    "@fullcalendar/core": "^7.1.3",
    "@fullcalendar/rrule": "^7.1.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "codemirror": "^6.0.2",
    "fullcalendar": "^7.1.3",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.0",
    "temporal-polyfill": "^1.0.6",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "^1.1.0",
    "otplib": "^13.5.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
