# Cockpit deployment settings, read by deploy/docker-compose.yml.
# Copy to deploy/.env, or generate it with secrets filled in: `sh deploy/gen-env.sh cockpit.example.org`.
# Never commit deploy/.env.

# Public host name. Caddy gets a Let's Encrypt certificate for it (DNS must point here, ports 80/443 open).
# `localhost` uses Caddy's internal CA instead (local testing).
COCKPIT_DOMAIN=cockpit.example.org

# Host ports Caddy listens on. Rootless Podman can't bind < 1024 by default: use e.g. 8080/8443 for tests.
COCKPIT_HTTP_PORT=80
COCKPIT_HTTPS_PORT=443

# AES-256 key for stored credentials: base64 of 32 random bytes (`openssl rand -base64 32`).
# Losing it makes stored IMAP passwords and OAuth tokens unreadable: keep a copy outside this server.
COCKPIT_MASTER_KEY=change-me

# PostgreSQL password of the `cockpit` user (`openssl rand -hex 24`). Only used inside the stack.
POSTGRES_PASSWORD=change-me

# Optional: image to run instead of the locally built one.
# COCKPIT_IMAGE=localhost/cockpit-server:latest

# Optional: OAuth apps for Google / Microsoft calendars, contacts and mail (docs/oauth-setup.md).
# COCKPIT_OAUTH_PUBLICURL is the origin of the redirect URIs registered with the providers
# (`<url>/api/v1/oauth/<provider>/callback`). Default: https://$COCKPIT_DOMAIN. Set it when
# COCKPIT_HTTPS_PORT isn't 443, e.g. COCKPIT_OAUTH_PUBLICURL=https://cockpit.example.org:8443
# COCKPIT_OAUTH_PUBLICURL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# Optional: passkeys (WebAuthn). Empty: RP ID = COCKPIT_DOMAIN, accepted origin = https://<COCKPIT_DOMAIN>.
COCKPIT_AUTH_PASSKEY_RP_ID=
# Extra web origins (comma-separated; replaces the default, so keep the web origin). Usually empty.
COCKPIT_AUTH_PASSKEY_ORIGINS=
# For passkeys in the Android app: SHA-256 fingerprint(s) of the APK signing certificate, comma-separated
# (`apksigner verify --print-certs`, deploy/README.md). The server then serves /.well-known/assetlinks.json and
# accepts the app's origin android:apk-key-hash:<...> for each of them, e.g.
# COCKPIT_AUTH_PASSKEY_ANDROID_FINGERPRINTS=AB:CD:...(32 bytes)
COCKPIT_AUTH_PASSKEY_ANDROID_FINGERPRINTS=
# Package name of the app. Empty: ch.sonensei.cockpit.
COCKPIT_AUTH_PASSKEY_ANDROID_PACKAGE=
# Name the authenticator shows. Empty: My Cockpit.
COCKPIT_AUTH_PASSKEY_RP_NAME=
